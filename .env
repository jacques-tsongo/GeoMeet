# ============================================================
# GeoMeet - variables d'environnement (copier vers .env)
# NB : ne jamais committer un mot de passe reel dans ce fichier
# ============================================================

# Port utilise par le serveur Express + Socket.IO.
# En production (Render), Render injecte automatiquement PORT.
PORT=5000

# Cle secrete JWT : a remplacer par une valeur longue et aleatoire en production.
JWT_SECRET=b9ce8390d4de3eb88e8e900af74254e8d22f30dae6692099c14d896e53359c8523093a59656282cb0caf7f3cd3d08b21
JWT_EXPIRES_IN=7d

# Base de donnees MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=geomeet
DB_PORT=3306

# URL du frontend (utilisee pour l'autorisation CORS/Socket.IO).
# En local : http://localhost:5000
# En production (Render) : remplacer par l'URL https de votre application,
# ex : https://votre-app.onrender.com
FRONTEND_URL=http://localhost:5000