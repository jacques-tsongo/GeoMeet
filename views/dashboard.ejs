<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord - GeoMeet</title>
  <!-- MIGRATION HTML -> EJS : chemin CSS absolu servi par Express (/public) -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <!-- MIGRATION HTML -> EJS : lien vers la route de page /dashboard -->
    <a class="nav-brand" href="/dashboard"><span>G</span>GeoMeet</a>
    <div class="nav-actions">
      <span id="userName" class="nav-user"></span>
      <button id="logoutBtn" class="btn ghost">Deconnexion</button>
    </div>
  </nav>

  <main class="dashboard">
    <section class="hero-band">
      <div>
        <p class="eyebrow">Tableau de bord</p>
        <h1>Organisez une rencontre geolocalisee</h1>
      </div>
      <!-- Indicateur léger : nombre de personnes en ligne (liste supprimée) -->
      <div class="status-pill"><span id="onlineCount">0</span> en ligne</div>
    </section>

    <section class="search-panel">
      <div>
        <h2>Rechercher une personne</h2>
        <p class="muted">Recherchez par nom, prenom ou email, puis envoyez une demande.</p>
      </div>
      <form id="searchForm" class="search-form">
        <input id="searchInput" type="search" placeholder="Ex: patrick" minlength="2">
        <button class="btn primary" type="submit">Rechercher</button>
      </form>
      <div id="searchResults" class="list"></div>
    </section>

    <!-- Demandes reçues / envoyées / sessions actives (plus de liste
         permanente de tous les utilisateurs dans le dashboard). -->
    <section class="dashboard-grid">
      <div class="panel">
        <h2>Demandes recues</h2>
        <div id="receivedRequests" class="list compact"></div>
      </div>
      <div class="panel">
        <h2>Demandes envoyees</h2>
        <div id="sentRequests" class="list compact"></div>
      </div>
      <div class="panel">
        <h2>Rencontres actives</h2>
        <div id="activeSessions" class="list compact"></div>
      </div>
    </section>
  </main>

  <div id="toast" class="toast"></div>
  <!-- Bannière de demande reçue : notification interactive temps réel,
       affichée dès que l'événement Socket.IO meeting:request arrive. -->
  <div id="requestBanner" class="request-banner" hidden></div>
  <!-- Socket.IO cote serveur (meme origine) + script JS absolu (/public) -->
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>