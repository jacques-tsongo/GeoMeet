<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion - GeoMeet</title>
  <!-- MIGRATION HTML -> EJS : chemin CSS absolu servi par Express (/public) -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="brand-panel">
      <div class="brand-mark">G</div>
      <h1>GeoMeet</h1>
      <p>Retrouvez quelqu'un facilement grace au partage temporaire de localisation.</p>
    </section>

    <section class="auth-card">
      <h2>Connexion</h2>
      <p class="muted">Accedez a votre espace de rencontre.</p>
      <form id="loginForm" class="form">
        <label>Email
          <input type="email" name="email" required autocomplete="email">
        </label>
        <label>Mot de passe
          <input type="password" name="password" required autocomplete="current-password">
        </label>
        <button class="btn primary" type="submit">Se connecter</button>
      </form>
      <p id="message" class="message"></p>
      <!-- MIGRATION HTML -> EJS : lien vers la route EJS /register -->
      <p class="switch-link">Pas encore de compte ? <a href="/register">Creer un compte</a></p>
    </section>
  </main>
  <!-- MIGRATION HTML -> EJS : script JS absolu servi par Express (/public) -->
  <script src="/js/login.js"></script>
</body>
</html>