<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page introuvable - GeoMeet</title>
  <!-- Page 404 rendue par Express avec EJS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="brand-panel">
      <div class="brand-mark">G</div>
      <h1>404</h1>
      <p>Cette page n'existe pas ou a ete deplacee.</p>
    </section>

    <section class="auth-card">
      <h2>Page introuvable</h2>
      <p class="muted">La page que vous cherchez n'existe pas.</p>
      <p style="margin-top: 24px;">
        <a class="btn primary" href="/">Retour a l'accueil</a>
      </p>
      <p class="switch-link">Vous avez un compte ? <a href="/login">Se connecter</a></p>
    </section>
  </main>
</body>
</html>